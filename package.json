{
  "name": "outagemap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"messages/*.json\" \"*.{ts,mjs,json}\"",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "maintenance": "tsx --env-file=.env scripts/maintenance.ts",
    "db:generate": "prisma generate",
    "test:e2e": "playwright test",
    "storage:cors": "tsx --env-file=.env scripts/storage-cors.ts",
    "verify:deployment": "tsx --env-file=.env scripts/verify-deployment.ts",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.17.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "ioredis": "^5.8.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.14.0",
    "maxmind": "^5.0.7",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.63.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.9.10",
    "prisma": "^6.17.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
